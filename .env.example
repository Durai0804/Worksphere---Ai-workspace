# Smart Workplace OS - Environment Configuration
# Frontend: Vercel  |  Backend: Render

# ── Shared ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRE=7d

# ═══════════════════════════════════════════════════════════
# BACKEND (Render)
# ═══════════════════════════════════════════════════════════
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/smart-workplace-os
# Comma-separated list of allowed origins (Vercel app URLs)
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
# AI API Key (optional)
AI_API_KEY=

# ═══════════════════════════════════════════════════════════
# FRONTEND (Vercel — set in Vercel Dashboard → Environment Variables)
# ═══════════════════════════════════════════════════════════
# VITE_API_URL=https://your-app.onrender.com/api
# VITE_FACE_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model
