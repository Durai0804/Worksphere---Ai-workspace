# Smart Workplace OS - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB - Use local or Atlas
MONGODB_URI=mongodb://localhost:27017/smart-workplace-os

# JWT
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRE=7d

# CORS - Frontend URL
CORS_ORIGIN=http://localhost:5173

# AI API Key (optional - for future LLM integration)
AI_API_KEY=

# Docker Compose overrides (for production deployment)
# JWT_SECRET=<your-production-secret>
# CORS_ORIGIN=https://yourdomain.com
