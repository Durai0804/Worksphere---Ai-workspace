# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/smart-workplace-os

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_secure_random_string_in_production
JWT_EXPIRE=7d

# ── CORS (comma-separated; .vercel.app and .onrender.com are auto-allowed) ──
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── AI API Key (optional ─ for future LLM integration) ─────
AI_API_KEY=

# ── Production overrides (set in Render dashboard) ─────────
# PORT=5000
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=<random-64-char-string>
# JWT_EXPIRE=7d
# CORS_ORIGIN=https://your-app.vercel.app
